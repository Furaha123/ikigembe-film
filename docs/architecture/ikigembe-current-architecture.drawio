        <mxCell id="overview-admin" value="&lt;b&gt;Admin&lt;/b&gt; (staff)" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#E4E7EB;strokeColor=#52606D;fontSize=12;fontColor=#1F2933;" vertex="1" parent="overview-users">
