        <mxCell id="overview-pawapay" value="&lt;b&gt;PawaPay&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;mobile-money deposits (prompt on the payer's phone) · producer payouts · refunds&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-pay">
