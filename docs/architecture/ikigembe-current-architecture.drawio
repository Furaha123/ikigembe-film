        </mxCell>
        <mxCell id="overview-vercel" value="&lt;b&gt;Vercel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;static hosting + routing&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F7F7F8;strokeColor=#1F2933;strokeWidth=2;fontSize=14;fontColor=#1F2933;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="overview-1">
          <mxGeometry x="300" y="150" width="340" height="560" as="geometry" />
        </mxCell>
        <mxCell id="overview-spa" value="&lt;b&gt;Angular 19 single-page app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;standalone components · ngx-translate (EN / RW)&lt;br&gt;client-only build (SSR files present, not enabled)&lt;br&gt;&lt;br&gt;In the browser:&lt;br&gt;• access JWT in memory; refresh token in an httpOnly cookie&lt;br&gt;• hls.js player&lt;br&gt;• per-browser device id, sent on /stream/ only&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-vercel">
          <mxGeometry x="20" y="60" width="300" height="210" as="geometry" />
        </mxCell>
        <mxCell id="overview-routes" value="&lt;b&gt;Edge routes (Build Output API)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;scripts/vercel-output.mjs&lt;br&gt;• /api/* and /sitemap.xml → backend&lt;br&gt;• crawlers on /movie/:id, /casting/:id → SEO pages&lt;br&gt;• everything else → index.html&lt;br&gt;&lt;br&gt;Production → ikigembe-backend.onrender.com&lt;br&gt;Preview builds must set BACKEND_ORIGIN&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-vercel">
          <mxGeometry x="20" y="330" width="300" height="205" as="geometry" />
        </mxCell>
        <mxCell id="overview-render" value="&lt;b&gt;Render&lt;/b&gt; · render.yaml blueprint (production) — web service, worker, 6 cron jobs, PostgreSQL" style="fontFamily=Helvetica;rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F5F3FF;strokeColor=#6B4FD8;strokeWidth=2;fontSize=14;fontColor=#1F2933;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="overview-1">
          <mxGeometry x="720" y="150" width="990" height="790" as="geometry" />
        </mxCell>
        <mxCell id="overview-django" value="&lt;b&gt;ikigembe-backend — Render web service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;Django 6 + Django REST Framework on Gunicorn · one deployable (modular monolith, apps/*)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#6B4FD8;strokeWidth=1.5;fontSize=13;fontColor=#1F2933;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="overview-render">
          <mxGeometry x="25" y="55" width="620" height="610" as="geometry" />
        </mxCell>
        <mxCell id="overview-auth" value="&lt;b&gt;Authentication &amp; authorization&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;SimpleJWT: 30-min access + 7-day rotating refresh (blacklist, httpOnly cookie) · Google ID-token sign-in · roles Viewer / Producer / Admin · one active session per account · IP throttles + login lockout&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-django">
          <mxGeometry x="20" y="58" width="580" height="84" as="geometry" />
        </mxCell>
        <mxCell id="overview-cap1" value="&lt;b&gt;Catalog &amp; release&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;listing, search, detail · coming-soon gating · admin-only prices&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-django">
          <mxGeometry x="20" y="150" width="184" height="115" as="geometry" />
        </mxCell>
        <mxCell id="overview-cap2" value="&lt;b&gt;Playback &amp; entitlement&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;/stream/ · HLS playlist proxy (signed token) · entitlement re-checked per playlist · optional device binding, watermark&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-django">
          <mxGeometry x="218" y="150" width="184" height="115" as="geometry" />
        </mxCell>
        <mxCell id="overview-cap3" value="&lt;b&gt;Media uploads&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;S3 multipart: initiate, sign-part, complete · server-minted keys · extension allow-lists&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-django">
          <mxGeometry x="416" y="150" width="184" height="115" as="geometry" />
        </mxCell>
