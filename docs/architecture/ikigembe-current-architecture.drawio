        <mxCell id="overview-title" value="IKIGEMBE — Current High-Level Architecture" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="overview-1">
