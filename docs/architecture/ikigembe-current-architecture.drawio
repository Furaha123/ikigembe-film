          <mxGeometry x="20" y="277" width="184" height="115" as="geometry" />
        </mxCell>
        <mxCell id="overview-cap5" value="&lt;b&gt;Contracts &amp; finance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;e-signed distribution agreement · per-film revenue shares · ledger · monthly reports&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-django">
          <mxGeometry x="218" y="277" width="184" height="115" as="geometry" />
        </mxCell>
        <mxCell id="overview-cap6" value="&lt;b&gt;Actor marketplace&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;actor profiles · paid talent videos (ffprobe checks) · paid casting calls · directory access&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-django">
          <mxGeometry x="416" y="277" width="184" height="115" as="geometry" />
        </mxCell>
        <mxCell id="overview-cap7" value="&lt;b&gt;Admin &amp; moderation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;dashboard · film approval · video / casting moderation · audit log · abuse reports&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-django">
          <mxGeometry x="20" y="404" width="184" height="115" as="geometry" />
        </mxCell>
        <mxCell id="overview-cap8" value="&lt;b&gt;CMS, ads &amp; analytics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;pages · ad campaigns · first-party events · crawler SEO pages · sitemap&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-django">
          <mxGeometry x="218" y="404" width="184" height="115" as="geometry" />
        </mxCell>
        <mxCell id="overview-cap9" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;in-app inboxes · emails queued in EmailOutbox (idempotent), retried by cron&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-django">
          <mxGeometry x="416" y="404" width="184" height="115" as="geometry" />
        </mxCell>
        <mxCell id="overview-threads" value="&lt;b&gt;In-process background threads (no task queue)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;HLS transcode started after a video upload · email delivery after the DB commit (pool of 2)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;dashed=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F7F8;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-django">
          <mxGeometry x="20" y="534" width="580" height="58" as="geometry" />
        </mxCell>
        <mxCell id="overview-worker" value="&lt;b&gt;transcode-worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;Render background worker&lt;br&gt;polls PostgreSQL every 30 s, claims one film&lt;br&gt;local FFmpeg → multi-rendition HLS (6 s segments)&lt;br&gt;optional AES-128 (HLS_ENCRYPTION)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-render">
          <mxGeometry x="685" y="105" width="275" height="150" as="geometry" />
        </mxCell>
        <mxCell id="overview-db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;Render database ikigembe_db (render.yaml fromDatabase)&lt;br&gt;also the Django cache table (rate limits, refresh-token grace)&lt;/span&gt;" style="fontFamily=Helvetica;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="overview-render">
          <mxGeometry x="685" y="305" width="275" height="165" as="geometry" />
        </mxCell>
        <mxCell id="overview-crons" value="&lt;b&gt;Render cron jobs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;reconcile_payments · every 10 min&lt;br&gt;send_outbox (→ Resend) · every 5 min&lt;br&gt;marketplace_jobs · every 5 min&lt;br&gt;publish_releases · every 15 min&lt;br&gt;expire_contracts · hourly&lt;br&gt;reset_stale_transcodes · hourly&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-render">
          <mxGeometry x="685" y="510" width="275" height="175" as="geometry" />
        </mxCell>
        <mxCell id="overview-r2" value="&lt;b&gt;Cloudflare R2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;S3-compatible object storage&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFF7ED;strokeColor=#F38020;strokeWidth=2;fontSize=14;fontColor=#1F2933;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="overview-1">
          <mxGeometry x="1760" y="150" width="440" height="560" as="geometry" />
        </mxCell>
        <mxCell id="overview-pub" value="&lt;b&gt;Public bucket&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;thumbnails · backdrops · trailers · ad creatives&lt;br&gt;plain URLs on the R2 custom domain&lt;br&gt;(cache rules are not defined in the repos)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-r2">
          <mxGeometry x="30" y="65" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="overview-priv" value="&lt;b&gt;Private bucket&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;full videos · HLS playlists and segments · subtitles · talent videos · copyright documents · contract signatures&lt;br&gt;&lt;br&gt;No public URL: reachable only through short-lived presigned URLs on the S3 API endpoint, or the HLS proxy&lt;br&gt;&lt;br&gt;Making the bucket private is an operator step (docs/r2-resend.md); if the variable is unset, private media falls back to the public bucket&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-r2">
          <mxGeometry x="30" y="250" width="380" height="230" as="geometry" />
        </mxCell>
        <mxCell id="overview-google" value="&lt;b&gt;Google Identity Services&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;&quot;Sign in with Google&quot; (gsi/client)&lt;br&gt;ID token verified by the API (google-auth)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-1">
          <mxGeometry x="745" y="1010" width="190" height="125" as="geometry" />
        </mxCell>
        <mxCell id="overview-resend" value="&lt;b&gt;Resend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;transactional email through django-anymail (HTTPS API)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="overview-1">
          <mxGeometry x="965" y="1010" width="190" height="125" as="geometry" />
        </mxCell>
        <mxCell id="overview-pay" value="Payment gateway&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;one active · PAYMENT_GATEWAY&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F0FAF4;strokeColor=#2F855A;strokeWidth=2;fontSize=14;fontColor=#1F2933;align=right;verticalAlign=top;spacingRight=12;spacingTop=6;" vertex="1" parent="overview-1">
